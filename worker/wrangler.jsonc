{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classsniper-api",
  "main": "src/index.ts",
  // Pinned to what the test runtime's bundled workerd supports, rather than today,
  // so tests and production run on the same compatibility date instead of a newer
  // deploy quietly diverging from what was tested. Raise it when the vitest pool
  // ships a newer runtime.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },

  // Deliberately no cron trigger. The external cron that wakes the booking
  // workflow every 60s is the one piece of this system with a proven cadence, and
  // Cloudflare's scheduler is best-effort in the same way GitHub's is — the thing
  // that made an external cron necessary in the first place. The end user never
  // sees it either way, so moving it would trade strike timing for nothing.
  "vars": {
    "GITHUB_OWNER": "SidharthJoly",
    "GITHUB_REPO": "ClassSniper",
    "GITHUB_BRANCH": "main",
    // Only the dashboard may call this. Anything else gets no CORS headers back.
    // Two entries because Pages serves from the custom domain and 301s the
    // github.io URL to it — a browser sent from the latter still ends up with the
    // former as its origin, but both are the dashboard.
    "ALLOWED_ORIGINS": "https://classsniper.sidharthjoly.com,https://sidharthjoly.github.io"
  },

  // Where the personal state lives now: what you booked, what's queued, your
  // standing rules. It used to be JSON files in a public repo, which published
  // your gym schedule to anyone who looked. D1 rather than KV because KV is
  // eventually consistent by up to 60s, and a booking armed from the dashboard
  // has to be visible to the striker on its very next run.
  "d1_databases": [
    {
      "binding": "STATE_DB",
      "database_name": "classsniper-state",
      "database_id": "15cc1c68-8fd4-46db-8cdd-b95284d64b4b"
    }
  ],

  // The passphrase is the only thing between the internet and someone else's gym
  // account, and a workers.dev hostname is guessable. timingSafeEqual handles the
  // side channel; this handles volume.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]

  // Secrets, set with `wrangler secret put` — never in this file:
  //   GITHUB_TOKEN          fine-grained PAT, this repo only, Contents: read & write
  //   DASHBOARD_PASSPHRASE  what the dashboard sends as its bearer token
}
